  <pardefs>

  <pardef n="pron__:pl.nom" c="Turn all cases to nom for these, add pl">
      <!-- TODO: is buot→divnna ever sg? -->
      <e>  <p><l><s n="attr"/></l><r><s n="attr"/></r></p></e>
      <e>   <p><l><s n="nom"/></l><r><s n="pl"/><s n="nom"/></r></p></e>
      <e r="LR">  <p><l><s n="acc"/></l><r><s n="pl"/><s n="nom"/></r></p></e>
      <e r="LR">  <p><l><s n="gen"/></l><r><s n="pl"/><s n="nom"/></r></p></e>
      <e r="LR">  <p><l><s n="ill"/></l><r><s n="pl"/><s n="nom"/></r></p></e>
      <e r="LR">  <p><l><s n="loc"/></l><r><s n="pl"/><s n="nom"/></r></p></e>
      <e r="LR">  <p><l><s n="ess"/></l><r><s n="pl"/><s n="nom"/></r></p></e>
    </pardef>
  <pardef n="not_attr">
      <e><p><l><s n="sg"/></l><r><s n="sg"/></r></p></e>
      <e><p><l><s n="pl"/></l><r><s n="pl"/></r></p></e>
      <e><p><l><s n="ess"/></l><r><s n="ess"/></r></p></e>
    </pardef>
    <pardef n="duhat_milj" c="includes empty transition">
      <e><p><l><s n="num"/></l><r><s n="num"/></r></p></e>
      <e><p><l>duhát<s n="num"/></l><r>tuvsán<s n="num"/></r></p></e>
      <e><p><l>miljovdna<s n="num"/></l><r>millijåvnnå<s n="num"/></r></p></e>
    </pardef>
    <pardef n="okta_ovcci" c="includes no empty transition">
      <e><p><l>okta</l><r>akta</r></p><par n="duhat_milj"/></e>
      <e><p><l>guokte</l><r>guokta</r></p><par n="duhat_milj"/></e>
      <e><p><l>golbma</l><r>gålmmå</r></p><par n="duhat_milj"/></e>
      <e><p><l>njeallje</l><r>niellja</r></p><par n="duhat_milj"/></e>
      <e><p><l>vihtta</l><r>vihtta</r></p><par n="duhat_milj"/></e>
      <e><p><l>guhtta</l><r>guhtta</r></p><par n="duhat_milj"/></e>
      <e><p><l>čieža</l><r>giehtja</r></p><par n="duhat_milj"/></e>
      <e><p><l>gávcci</l><r>gáktsa</r></p><par n="duhat_milj"/></e>
      <e><p><l>ovcci</l><r>aktse</r></p><par n="duhat_milj"/></e>
    </pardef>
    <pardef n="0_logi" c="includes empty transition">
      <e><p><l><s n="num"/></l><r><s n="num"/></r></p></e>  <!-- 102  -->
      <e><p><l>logi</l><r>låk</r></p><par n="okta_ovcci"/></e> <!-- 129  -->
      <e><p><l>logi<s n="num"/></l><r>låhke<s n="num"/></r></p></e> <!-- 120  -->
    </pardef>
    <pardef n="0_guokte-ovccilogi" c="includes empty transition">
      <e><p><l><s n="num"/></l><r><s n="num"/></r></p></e>  <!-- 100 -->
      <e><p><l>okta<s n="num"/></l><r>akta<s n="num"/></r></p></e> <!-- 101 -->
      <e><p><l>guokte</l><r>guokta</r></p><par n="0_logi"/></e> <!-- 12N -->
      <e><p><l>golbma</l><r>gålmmå</r></p><par n="0_logi"/></e> <!-- 13N -->
      <e><p><l>njeallje</l><r>niellja</r></p><par n="0_logi"/></e> <!-- 14N -->
      <e><p><l>vihtta</l><r>vihtta</r></p><par n="0_logi"/></e> <!-- 15N -->
      <e><p><l>guhtta</l><r>guhtta</r></p><par n="0_logi"/></e> <!-- 16N -->
      <e><p><l>čieža</l><r>giehtja</r></p><par n="0_logi"/></e> <!-- 170 -->
      <e><p><l>gávcci</l><r>gáktsa</r></p><par n="0_logi"/></e> <!-- 18N -->
      <e><p><l>ovcci</l><r>aktse</r></p><par n="0_logi"/></e> <!-- 19N -->
    </pardef>
    <pardef n="0_logi_čuođi" c="includes an empty transition">
      <e><p><l><s n="num"/></l><r><s n="num"/></r></p></e>  <!-- 2  -->
      <e><p><l>čuođilogi<s n="num"/></l><r>tjuohtelåhke<s n="num"/></r></p></e> <!-- 200  -->
      <e><p><l>čuođi<s n="num"/></l><r>tjuohte<s n="num"/></r></p></e> <!-- 200  -->
      <e><p><l>logi<s n="num"/></l><r>låhke<s n="num"/></r></p></e> <!-- 20  -->
      <e><p><l>čuođi</l><r>tjuohte</r></p><par n="0_guokte-ovccilogi"/></e> <!-- 209  -->
      <e><p><l>logi</l><r>låk</r></p><par n="okta_ovcci"/></e> <!-- 29  -->
      <e><p><l>lot</l><r>låk</r></p></e>  <!-- 20 attr  -->
    </pardef>
  </pardefs>

  <section id="main" type="standard">

    <!-- Particles -->

    <e><p><l>dat<s n="pcle"/></l><r><s n="pcle"/></r></p></e> <!-- no pcle dat in smj, deleted in t1x -->
    <e><p><l>gal<s n="adv"/></l><r>gal<s n="pcle"/></r></p></e>
    <e><p><l>ge<s n="pcle"/></l><r><s n="pcle"/></r></p></e>
    <e><p><l>ge<s n="pcle"/></l><r>ga<s n="pcle"/></r></p></e>
    <e><p><l>ge<s n="pcle"/></l><r>vån<s n="pcle"/></r></p></e>
    <e><p><l>ge<s n="pcle"/></l><r>aj<s n="adv"/></r></p></e>
    <e><p><l>go<s n="pcle"/></l><r>gus<s n="pcle"/></r></p></e>
    <e><p><l>han<s n="pcle"/></l><r>ham<s n="pcle"/></r></p></e>
    <e><p><l>na<s n="pcle"/></l><r>na<s n="pcle"/></r></p></e>
    <e><p><l>nai<s n="pcle"/></l><r>aj<s n="pcle"/></r></p></e>
    <e><p><l>noa<s n="pcle"/></l><r>na<s n="pcle"/></r></p></e>
    <e><p><l>son<s n="pcle"/></l><r>så<s n="pcle"/></r></p></e>
    <e><p><l>gis<s n="pcle"/></l><r>gis<s n="pcle"/></r></p></e>
    <e><p><l>bat<s n="pcle"/></l><r>val<s n="adv"/></r></p></e>
    <e><p><l>hal<s n="pcle"/></l><r>dávk<s n="adv"/></r></p></e>

    <!-- Conjunctions -->

    <e><p><l>dassá<s n="cnjsub"/></l><r>desik<s n="cnjsub"/></r></p></e>
    <e><p><l>dassá<s n="adv"/></l><r>dás<b/>åvddåla<s n="adv"/></r></p></e>
    <e><p><l>dassái<s n="adv"/></l><r>desik<s n="adv"/></r></p></e>
    <e><p><l>ahte<s n="cnjsub"/></l><r>ahte<s n="cnjsub"/></r></p></e>
    <e><p><l>ahte<s n="cnjsub"/></l><r>jut<s n="cnjsub"/></r></p></e>
    <e><p><l>amas<s n="cnjsub"/></l><r>vaj<b/>ij<s n="cnjsub"/></r></p></e>
    <e><p><l>dan<b/>botta<b/>go<s n="cnjsub"/></l><r>dav<b/>båttåv<b/>gå<s n="cnjsub"/></r></p></e>
    <e><p><l>danin<b/>go<s n="cnjsub"/></l><r>danen<b/>gå<s n="cnjsub"/></r></p></e>
    <e><p><l>danin<s n="adv"/></l><r>danen<s n="adv"/></r></p></e>
    <e><p><l>danne<b/>go<s n="cnjsub"/></l><r>danen<b/>gå<s n="cnjsub"/></r></p></e>
    <e><p><l>dannego<s n="cnjsub"/></l><r>danen<b/>gå<s n="cnjsub"/></r></p></e>
    <e><p><l>daningo<s n="cnjsub"/></l><r>danen<b/>gå<s n="cnjsub"/></r></p></e>
    <e><p><l>dainnago<s n="cnjsub"/></l><r>danen<b/>gå<s n="cnjsub"/></r></p></e>
    <e><p><l>dassážiigo<s n="cnjsub"/></l><r>dallutjij<b/>gå<s n="cnjsub"/></r></p></e>
     <e><p><l>maŋŋelgo<s n="cnjsub"/></l><r>maŋŋela<b/>gå<s n="cnjsub"/></r></p></e>
    <e><p><l>das<b/>go<s n="cnjsub"/></l><r>dassta<b/>gå<s n="cnjsub"/></r></p></e>
    <e><p><l>dasgo<s n="cnjsub"/></l><r>dagu<s n="cnjsub"/></r></p></e>
    <e><p><l>dego<s n="cnjsub"/></l><r>degu<s n="cnjsub"/></r></p></e>
    <e r="LR"><p><l>dugo<s n="cnjsub"/></l><r>degu<s n="cnjsub"/></r></p></e>
    <e><p><l>dego<s n="adv"/></l><r>degu<s n="cnjsub"/></r></p></e>
    <e r="LR"><p><l>dugo<s n="adv"/></l><r>degu<s n="cnjsub"/></r></p></e>
    <e><p><l>dušše<b/>go<s n="cnjsub"/></l><r>dåssju<b/>gå<s n="cnjsub"/></r></p></e>
    <e><p><l>go<s n="cnjsub"/></l><r>gå<s n="cnjsub"/></r></p></e>
    <e><p><l>jos<s n="cnjsub"/></l><r>jus<s n="cnjsub"/></r></p></e>
    <e><p><l>jus<s n="cnjsub"/></l><r>jus<s n="cnjsub"/></r></p></e>
    <e><p><l>juos<s n="cnjsub"/></l><r>jus<s n="cnjsub"/></r></p></e>
    <e><p><l>juogo<s n="cnjsub"/></l><r>juogu<s n="cnjcoo"/></r></p></e>
    <e><p><l>jogo<s n="cnjsub"/></l><r>juogu<s n="cnjcoo"/></r></p></e>
    <e><p><l>jogo<s n="adv"/></l><r>juogu<s n="cnjcoo"/></r></p></e>
    <e><p><l>nu<b/>ahte<s n="cnjsub"/></l><r>danen<s n="cnjsub"/></r></p></e>
    <e><p><l>nu<b/>ahte<s n="cnjsub"/></l><r>vaj<s n="cnjsub"/></r></p></e>
    <e><p><l>nu<b/>ahte<s n="cnjsub"/></l><r>nav<b/>vaj<s n="cnjsub"/></r></p></e>
    <e><p><l>nu<b/>ahte<s n="cnjsub"/></l><r>navti<b/>ahte<s n="cnjsub"/></r></p></e>
    <e><p><l>nu<b/>guhkásgo<s n="cnjsub"/></l><r>nåv<b/>guhkás<b/>gå<s n="cnjsub"/></r></p></e>
    <e><p><l>nu<b/>gohčoduvvon<s n="adj"/></l><r>nav<b/>gåhtjodum<s n="adj"/></r></p></e>
    <e><p><l>nugo<s n="cnjsub"/></l><r>dagu<s n="cnjsub"/></r></p></e>
    <e><p><l>juogo<s n="adv"/></l><r>juogu<s n="cnjcoo"/></r></p></e>
    <e><p><l>nugo<s n="adv"/></l><r>navtik<s n="adv"/></r></p></e>
    <e><p><l>ovdal<b/>go<s n="cnjsub"/></l><r>åvddål<b/>gå<s n="cnjsub"/></r></p></e>
    <e><p><l>ovdalgo<s n="cnjsub"/></l><r>åvddål<b/>gå<s n="cnjsub"/></r></p></e>
    <e><p><l>seammás<b/>go<s n="cnjsub"/></l><r>sæmmi<b/>bále<s n="cnjsub"/></r></p></e>
    <e><p><l>vai<s n="cnjsub"/></l><r>vaj<s n="cnjsub"/></r></p></e>
    <e r="LR"><p><l>vái<s n="cnjsub"/></l><r>vaj<s n="cnjsub"/></r></p></e>
    <e><p><l>vaikke<s n="cnjsub"/></l><r>vájk<s n="cnjsub"/></r></p></e>
    <e><p><l>vaikko<s n="cnjsub"/></l><r>vájku<s n="cnjsub"/></r></p></e>
    <e><p><l>vaikko<b/>mii<s n="prn"/></l><r>vájk<b/>mij<s n="prn"/></r></p></e>

    <e><p><l>ahte<s n="cnjcoo"/></l><r>ja<s n="cnjcoo"/></r></p></e>

    <e r="RL"><p><l>dahje<s n="cnjcoo"/></l><r>jalik<s n="cnjcoo"/></r></p></e>
    <e r="LR"><p><l>dahe<s n="cnjcoo"/></l><r>jali<s n="cnjcoo"/></r></p></e>
    <e r="LR"><p><l>dahege<s n="cnjcoo"/></l><r>jali<s n="cnjcoo"/></r></p></e>
    <e><p><l>dahje<s n="cnjcoo"/></l><r>jalik<s n="cnjcoo"/></r></p></e>
    <e r="LR"><p><l>dahjege<s n="cnjcoo"/></l><r>jali<s n="cnjcoo"/></r></p></e>
    <e r="LR"><p><l>dehe<s n="cnjcoo"/></l><r>jalik<s n="cnjcoo"/></r></p></e>
    <e r="LR"><p><l>dehege<s n="cnjcoo"/></l><r>jali<s n="cnjcoo"/></r></p></e>
    <e r="LR"><p><l>elege<s n="cnjcoo"/></l><r>jali<s n="cnjcoo"/></r></p></e>

    <e r="LR"><p><l>ele<s n="cnjcoo"/></l><r>valla<s n="cnjcoo"/></r></p></e>
    <e><p><l>ja<s n="cnjcoo"/></l><r>ja<s n="cnjcoo"/></r></p></e>
    <e><p><l>muhto<s n="cnjcoo"/></l><r>valla<s n="cnjcoo"/></r></p></e>
